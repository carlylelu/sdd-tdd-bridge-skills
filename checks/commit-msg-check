#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: commit-msg-check --repo <repo-root> --message-file <path>' >&2
  exit 2
}

repo=''
message_file=''
while (($#)); do
  case "$1" in
    --repo) repo=${2:-}; shift 2 ;;
    --message-file) message_file=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$repo" && -d "$repo/.git" && -f "$message_file" ]] || usage
cd "$repo"

block_count=0
block() {
  printf '[%s][BLOCK] %s\n' "$1" "$2" >&2
  block_count=$((block_count + 1))
}

first_line=$(sed -n '1p' "$message_file")

# 检查首行格式：<type>(<scope>): <description>
header_re='^(feat|fix|refactor|docs|test|chore)\(([A-Za-z0-9._/-]+)\):[[:space:]]+.+$'
if [[ ! "$first_line" =~ $header_re ]]; then
  block BRIDGE-COMMIT-001 '首行必须匹配 <type>(<scope>): <description>'
  commit_type=''
else
  commit_type=${BASH_REMATCH[1]}
fi

# 检查 Change-Id Trailer
change_id_count=$(grep -Ec '^Change-Id:[[:space:]]+.+$' "$message_file" || true)
if [[ "$change_id_count" -eq 0 ]]; then
  # 不强制要求所有 commit 都有 Change-Id，只有涉及 openspec/changes/ 的 commit 才要求
  # 检查暂存区是否涉及 openspec/changes/
  has_openspec_change=$(git diff --cached --name-only --diff-filter=ACMRD -- 'openspec/changes/*' 2>/dev/null | head -n1 || true)
  if [[ -n "$has_openspec_change" ]]; then
    block BRIDGE-COMMIT-002 '涉及 openspec/changes/ 的 Commit 必须包含 Change-Id Trailer'
  fi
elif [[ "$change_id_count" -gt 1 ]]; then
  block BRIDGE-COMMIT-003 'Commit 只能包含一个 Change-Id Trailer'
else
  change_id=$(sed -nE 's/^Change-Id:[[:space:]]+(.+)$/\1/p' "$message_file" | head -n1)
  # 检查 Change-Id 对应的变更目录存在
  change_dir="openspec/changes/$change_id"
  if [[ ! -d "$change_dir" ]]; then
    block BRIDGE-COMMIT-004 "Change-Id 对应的变更目录不存在: $change_dir"
  fi
fi

if ((block_count > 0)); then
  echo "[BRIDGE-COMMIT][BLOCK] 共发现${block_count}个问题" >&2
  exit 1
fi
echo '[BRIDGE-COMMIT][PASS] Commit Message 检查通过'
