#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: openspec-format-check --repo <repo-root> [--change <change-name>] [--staged]' >&2
  exit 2
}

repo=''
change=''
staged=false
while (($#)); do
  case "$1" in
    --repo) repo=${2:-}; shift 2 ;;
    --change) change=${2:-}; shift 2 ;;
    --staged) staged=true; shift ;;
    *) usage ;;
  esac
done
[[ -n "$repo" && -d "$repo/.git" ]] || usage
cd "$repo"

block_count=0
block() {
  printf '[%s][BLOCK] %s\n' "$1" "$2" >&2
  block_count=$((block_count + 1))
}

# 确定要检查的变更目录
changes_dir="openspec/changes"

if [[ "$staged" == true ]]; then
  # 暂存区模式：检查暂存区涉及的 openspec/changes/ 文件
  mapfile -d '' changed < <(git diff --cached --name-only -z --diff-filter=ACMRD -- 'openspec/changes/*' 2>/dev/null || true)
  if ((${#changed[@]} == 0)); then
    echo '[BRIDGE-OPENSPEC][PASS] 暂存区不包含 openspec/changes/ 文件，跳过格式检查'
    exit "$block_count"
  fi
  # 从暂存文件路径提取变更目录名
  declare -A change_dirs=()
  for path in "${changed[@]}"; do
    if [[ "$path" =~ ^openspec/changes/([^/]+)/ ]]; then
      change_dirs["${BASH_REMATCH[1]}"]=1
    fi
  done
  change_list="${!change_dirs[@]}"
else
  # 全量模式：检查 openspec/changes/ 下所有未归档变更
  if [[ ! -d "$changes_dir" ]]; then
    echo '[BRIDGE-OPENSPEC][PASS] openspec/changes/ 目录不存在，跳过格式检查'
    exit "$block_count"
  fi
  if [[ -n "$change" ]]; then
    change_list="$change"
  else
    change_list=$(ls -1 "$changes_dir" 2>/dev/null || true)
  fi
fi

if [[ -z "$change_list" ]]; then
  echo '[BRIDGE-OPENSPEC][PASS] 无未归档变更，跳过格式检查'
  exit "$block_count"
fi

for change_name in $change_list; do
  change_path="$changes_dir/$change_name"

  if [[ ! -d "$change_path" ]]; then
    block BRIDGE-OPENSPEC-001 "变更目录不存在: $change_path"
    continue
  fi

  # 检查基础文件存在
  for required_file in proposal.md design.md tasks.md; do
    if [[ ! -f "$change_path/$required_file" ]]; then
      block BRIDGE-OPENSPEC-002 "$change_name: 缺少基础文件 $required_file"
    fi
  done

  # 检查 proposal.md 包含范围和排除范围
  if [[ -f "$change_path/proposal.md" ]]; then
    if ! grep -Eq '^#{1,6}[[:space:]].*(范围|Scope|In-Scope)' "$change_path/proposal.md"; then
      block BRIDGE-OPENSPEC-003 "$change_name/proposal.md: 缺少范围(Scope)章节"
    fi
    if ! grep -Eq '^#{1,6}[[:space:]].*(排除|Out-of-Scope|Exclusion)' "$change_path/proposal.md"; then
      block BRIDGE-OPENSPEC-004 "$change_name/proposal.md: 缺少排除范围(Out-of-Scope)章节"
    fi
  fi

  # 检查 design.md 包含技术方案
  if [[ -f "$change_path/design.md" ]]; then
    if ! grep -Eq '^#{1,6}[[:space:]].*(技术方案|方案|设计|Design|Architecture|架构)' "$change_path/design.md"; then
      block BRIDGE-OPENSPEC-005 "$change_name/design.md: 缺少技术方案/设计章节"
    fi
  fi

  # 检查 tasks.md 包含任务清单
  if [[ -f "$change_path/tasks.md" ]]; then
    if ! grep -Eq '^[[:space:]]*[-*][[:space:]]' "$change_path/tasks.md" && ! grep -Eq '^\|[[:space:]]' "$change_path/tasks.md"; then
      block BRIDGE-OPENSPEC-006 "$change_name/tasks.md: 未发现任务清单（列表或表格格式）"
    fi
  fi

  # 检查 specs/ 下的增量规范包含 Given/When/Then 场景
  specs_dir="$change_path/specs"
  if [[ -d "$specs_dir" ]]; then
    spec_files=$(find "$specs_dir" -name '*.md' -type f 2>/dev/null || true)
    if [[ -z "$spec_files" ]]; then
      block BRIDGE-OPENSPEC-007 "$change_name/specs/: 目录为空，缺少增量规范文件"
    else
      for spec_file in $spec_files; do
        # 检查包含 Given/When/Then（或中文 假设/当/则）
        if ! grep -Eq '(Given|假设)' "$spec_file"; then
          block BRIDGE-OPENSPEC-008 "$spec_file: 缺少 Given/假设 场景定义"
        fi
        if ! grep -Eq '(When|当)' "$spec_file"; then
          block BRIDGE-OPENSPEC-009 "$spec_file: 缺少 When/当 场景定义"
        fi
        if ! grep -Eq '(Then|则)' "$spec_file"; then
          block BRIDGE-OPENSPEC-010 "$spec_file: 缺少 Then/则 场景定义"
        fi
      done
    fi
  else
    # specs/ 目录不存在不一定是错误（简单变更可能没有 delta spec）
    # 但如果 proposal.md 提到了 specs/，则应该存在
    if grep -Eq 'specs/' "$change_path/proposal.md" 2>/dev/null; then
      block BRIDGE-OPENSPEC-011 "$change_name: proposal.md 引用了 specs/ 但目录不存在"
    fi
  fi

  # 检查占位符
  for check_file in proposal.md design.md tasks.md; do
    if [[ -f "$change_path/$check_file" ]]; then
      placeholder=$(grep -En '<[^>]+>|TODO|TBD|待补充|待填写' "$change_path/$check_file" | head -n1 || true)
      if [[ -n "$placeholder" ]]; then
        block BRIDGE-OPENSPEC-012 "$change_name/$check_file: 存在未完成占位符: $placeholder"
      fi
    fi
  done

done

if ((block_count > 0)); then
  echo "[BRIDGE-OPENSPEC][BLOCK] 共发现${block_count}个问题" >&2
  exit 1
fi
echo '[BRIDGE-OPENSPEC][PASS] OpenSpec 产物格式检查通过'
